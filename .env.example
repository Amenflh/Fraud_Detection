# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kaggle (prefer placing kaggle.json at ~/.kaggle/kaggle.json; these are an alternative)
KAGGLE_USERNAME=
KAGGLE_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
MODEL_ARTIFACT_DIR=data/models
FRAUD_SCORE_THRESHOLD=0.7

# Comma-separated list of origins allowed to call the API (CORS).
# In production, set this to your deployed frontend URL(s), e.g.:
# CORS_ALLOWED_ORIGINS=https://mon-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Supabase Postgres in production; defaults to a local SQLite file for
# dev/tests so nothing requires credentials). Example Postgres value:
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/local.db

# Supabase Auth: verifies Supabase-issued JWTs on protected endpoints.
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=

# Supabase project URL (verifies ES256 user tokens via JWKS)
SUPABASE_URL=

# SaaS fraud-check API key (header X-API-Key) and federation HMAC key
FRAUD_API_KEY=change-me
CONSORTIUM_KEY=change-me

# ---------------------------------------------------------------------------------------
# Roles: accounts need app_metadata.role (see scripts/manage_users.py). Access is denied by
# default. STAFF_EMAILS keeps existing back-office accounts working as "gestionnaire".
STAFF_EMAILS=
# Used by scripts/manage_users.py only. SECRET: server-side, never in the frontend or git.
SUPABASE_SERVICE_ROLE_KEY=

# Where users open the web app (links in e-mails/SMS, QR code printed on the constat PDF).
PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------
# Notifications. Without credentials, messages are recorded and marked "simulated".
NOTIFICATIONS_ENABLED=true
# Safety net for demos: when set, ONLY these e-mails/phones are really contacted.
NOTIFY_ALLOWLIST=
# Managers who receive the fraud alert e-mail, and the rules score (0-100) that triggers it.
ALERT_EMAILS=
FRAUD_ALERT_THRESHOLD=50

# E-mail over SMTP (Brevo, Mailgun, Mailtrap, Gmail app password...). 587 = STARTTLS, 465 = SMTP_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sentinelle <no-reply@your-domain.tld>
SMTP_SSL=false

# SMS through Twilio. TWILIO_FROM: a number (+1...), an alphanumeric sender id, or a messaging service (MG...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=+216

