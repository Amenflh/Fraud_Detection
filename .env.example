# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kaggle (prefer placing kaggle.json at ~/.kaggle/kaggle.json; these are an alternative)
KAGGLE_USERNAME=
KAGGLE_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
MODEL_ARTIFACT_DIR=data/models
FRAUD_SCORE_THRESHOLD=0.7

# Comma-separated list of origins allowed to call the API (CORS).
# In production, set this to your deployed frontend URL(s), e.g.:
# CORS_ALLOWED_ORIGINS=https://mon-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (Supabase Postgres in production; defaults to a local SQLite file for
# dev/tests so nothing requires credentials). Example Postgres value:
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/local.db

# Supabase Auth: verifies Supabase-issued JWTs on protected endpoints.
# Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=

# Supabase project URL (verifies ES256 user tokens via JWKS)
SUPABASE_URL=

# SaaS fraud-check API key (header X-API-Key) and federation HMAC key
FRAUD_API_KEY=change-me
CONSORTIUM_KEY=change-me
